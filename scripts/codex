#!/bin/sh
# codex: Launch Codex CLI using the VSCode extension's native binary.
# Dynamically finds the latest installed version so it follows extension updates.

# Detect OS/arch so this works both locally (macOS, ~/.vscode) and on the
# remote dev box (Linux, ~/.vscode-server).
case "$(uname -s)" in
  Darwin) OS=darwin; CODEX_OS=macos ;;
  Linux)  OS=linux;  CODEX_OS=linux ;;
  *)      OS=linux;  CODEX_OS=linux ;;
esac
case "$(uname -m)" in
  arm64|aarch64) ARCH=arm64; CODEX_ARCH=aarch64 ;;
  x86_64|amd64)  ARCH=x64;   CODEX_ARCH=x86_64 ;;
  *)             ARCH=arm64; CODEX_ARCH=aarch64 ;;
esac
PLATFORM="$OS-$ARCH"

# Search both extension roots (local VSCode and remote vscode-server),
# pick the highest version across both.
LATEST_EXT=$(ls -d \
    "$HOME/.vscode/extensions/openai.chatgpt-"*"-$PLATFORM" \
    "$HOME/.vscode-server/extensions/openai.chatgpt-"*"-$PLATFORM" \
    2>/dev/null \
  | sed 's|.*/openai\.chatgpt-||' \
  | sort -t- -k1 -V \
  | tail -1)
if [ -n "$LATEST_EXT" ]; then
  for root in "$HOME/.vscode/extensions" "$HOME/.vscode-server/extensions"; do
    cand="$root/openai.chatgpt-$LATEST_EXT"
    [ -d "$cand" ] && LATEST_EXT="$cand" && break
  done
fi

if [ -z "$LATEST_EXT" ] || [ ! -d "$LATEST_EXT" ]; then
  echo "Error: OpenAI ChatGPT VSCode extension not found (platform: $PLATFORM)." >&2
  echo "Install it from the VSCode marketplace first." >&2
  exit 1
fi

CODEX="$LATEST_EXT/bin/$CODEX_OS-$CODEX_ARCH/codex"

if [ ! -x "$CODEX" ]; then
  echo "Error: Codex binary not found at $CODEX" >&2
  exit 1
fi

exec "$CODEX" "$@"
