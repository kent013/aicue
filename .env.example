APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SES 実送信 (MAIL_MAILER=ses) 用。運用手順は docs/ses-mail-runbook.md
# 送信に付与する Configuration Set 名 (未設定なら付与しない)
SES_CONFIGURATION_SET=
# バウンス/苦情通知の受信を許可する SNS TopicArn (カンマ区切り)。空のときは全通知を拒否
SES_SNS_TOPIC_ARNS=

VITE_APP_NAME="${APP_NAME}"

# --- billing ---
# Stripe API キー (Cashier。課金主体は Organization)
STRIPE_KEY=
STRIPE_SECRET=
# webhook 署名検証シークレット (php artisan cashier:webhook で endpoint 作成)
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=jpy
# Stripe Price は env ではなく stripe/fixtures/*.json (desired state) +
# `php artisan billing:sync-stripe-prices` で plan_prices (DB snapshot) に同期する
# JCT 適格請求書用の inclusive TaxRate ID (未設定なら税分離なし。本番では設定すること)
STRIPE_TAX_RATE_ID=
# Customer Portal Configuration ID (billing:ensure-portal-configuration で生成。
# subscription_update 無効の spec 準拠 configuration。未設定なら Dashboard 既定)
STRIPE_PORTAL_CONFIGURATION_ID=
# チケット付与・傾斜単価 (config/billing.php。未設定時の既定: 10 枚 / 30 日 / floor 50)
#BILLING_SIGNUP_GRANT_TICKETS=10
#BILLING_SIGNUP_GRANT_EXPIRY_DAYS=30
#BILLING_TICKET_UNIT_PRICE_FLOOR=50
# チケット残高低下のアプリ内通知閾値 (config/billing.php。未設定時の既定: 5 枚)
#BILLING_TICKET_LOW_BALANCE_THRESHOLD=5

# --- render (config/manual.php。レンダ worker ホストの ffmpeg/ffprobe 要件) ---
# ffmpeg / ffprobe のバイナリパス (未設定なら PATH 上の ffmpeg / ffprobe)
#RENDER_FFMPEG_BINARY=ffmpeg
#RENDER_FFPROBE_BINARY=ffprobe
# 字幕焼き込みフォント (worker ホストにインストール済みの日本語対応フォント)
#RENDER_SUBTITLE_FONT="Noto Sans CJK JP"

# --- llm (config/prism.php) ---
# LLM provider の API キー (Prism)。使う provider のみ設定する。
# テスト中は phpunit.xml がダミー値で強制上書きし、実 API へは届かない
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- api / mcp ---
# MCP エンドポイント (/api/v1/mcp) の Origin allowlist (CSV)。
# production では未設定 = 全拒否 (fail-closed)。bare * は production で拒否される
MCP_ALLOWED_ORIGINS=
# Origin header を送らないクライアントを許可するか (false で CLI 等を許可)
MCP_STRICT_TRANSPORT=true
# MCP OAuth 2.1 (Passport) の署名鍵。dev / CI は `php artisan passport:keys` の
# storage/oauth-*.key で足りるが、production は必ず env で注入する
# (鍵ファイルの commit 禁止。config/passport.php のコメント参照)
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# --- template ---
# アプリの機械可読 slug (config/template.php)。API キー prefix 等に使う
TEMPLATE_APP_SLUG=app
# 部門 (Team) 層を UI に露出するか (docs/default-team-pattern.md)
TEMPLATE_TEAMS_VISIBLE=false
# /api/v1/version の capability negotiation (semver。設定ミスはリクエスト時に fail-fast)
# TEMPLATE_SERVER_VERSION=0.1.0
# TEMPLATE_MIN_CLI_VERSION=0.1.0
# first-party CLI の OAuth token TTL (clamp: access 5〜1440 分 / refresh 1〜90 日)
# TEMPLATE_CLI_ACCESS_TTL_MINUTES=60
# TEMPLATE_CLI_REFRESH_TTL_DAYS=30

# --- seo (config/seo.php) ---
# SEO 上のサイト名・既定 description。未設定時 site_name は APP_NAME に fallback する
# (APP_NAME に "(Alpha)" 等の表示用サフィックスを付ける場合はこちらで上書きする)
# SEO_SITE_NAME=
# SEO_DEFAULT_DESCRIPTION=
# ブラウザ UI / PWA の基調色。<meta theme-color> と public/site.webmanifest の単一ソース
# (未設定はニュートラルなプレースホルダ #1f2937。ブランド色へ差し替える)
# SEO_THEME_COLOR=

# --- analytics (config/services.php) ---
# Google Tag Manager コンテナ ID。production かつ本値が非空のときのみ GTM を描画する
# (二重ゲート)。未設定 = GTM 無効
# GTM_CONTAINER_ID=

# --- security / auth ---
# PII (users.email/name) 暗号化キー。php artisan ciphersweet:generate-key で生成
CIPHERSWEET_KEY=

# Host header injection 防御 (config/trusted_hosts.php)。
# production では allowlist が空だと起動時に fail-fast する (ProductionEnvGuard)。
# 本番のプライマリドメイン (host のみ。例: app.example.com)。APP_URL の host も自動許可される
PRIMARY_HOST=
# 追加で許可する host の CSV (alias / ヘルスチェック等)
TRUSTED_HOSTS_ADDITIONAL=
# 末尾一致で許可する suffix の CSV (先頭 dot + 2 ラベル以上。例: .preview.example.com)
TRUSTED_HOSTS_WILDCARD_SUFFIXES=
# client IP / X-Forwarded-Proto の信頼境界 (config/trustedproxy.php)。
# production では未宣言だと起動時に fail-fast する (ProductionEnvGuard)。
# **すべての hop** の IP / CIDR を CSV で列挙する (CloudFront -> ALB なら両方)。
# hop の取りこぼしは client IP をその hop に固定し、全利用者が 1 バケットに落ちる (自己 DoS)。
# プロキシが無い構成では `none` と明示する。ローカルで Valet TLS 越しに開発する場合は
# `REMOTE_ADDR` (production では禁止)。`*` は使用不可 (XFF 偽装が通る)。
# 運用手順は docs/trusted-proxies-runbook.md。
TRUSTED_PROXIES=
# 利用規約の同意バージョン (規約改定時に更新。config/legal.php)
LEGAL_CONSENT_VERSION=draft-1
# 問い合わせ (Inquiry) の保持日数 (spam=created_at / closed=closed_at 基準。inquiry:purge が日次削除)
LEGAL_INQUIRY_RETENTION_DAYS=365
# 問い合わせ受付通知の宛先 (未設定時は MAIL_FROM_ADDRESS。PII 保管先として扱う)
INQUIRY_RECIPIENT=
# 問い合わせ CTA の宛先 (未設定は内部フォーム /contact。外部 URL / mailto: も可)
MARKETING_CONTACT_URL=

# recent-auth (step-up 再認証) の鮮度ウィンドウ (秒)
AUTH_RECENT_AUTH_TIMEOUT=900

# local 専用デバッグログイン (/debug/login の Basic 認証。config/debug.php)。
# local でのみ設定する。production では必ず空のままにすること
# (ProductionEnvGuard が残置を検出して起動を fail-fast させる)
DEBUG_LOGIN_USER=
DEBUG_LOGIN_PASSWORD=

# Google SSO (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# パスキー (WebAuthn) は専用の env を持たない。Fortify が APP_URL から
# relying party id (ホスト) と allowed origins ([APP_URL]) を、user handle secret を
# APP_KEY から導出する (同一オリジン PWA 前提)。
# ⚠ APP_KEY をローテートすると既存パスキーの user handle が変わり全件無効になる。
#    運用契約は docs/architecture.md §パスキー (WebAuthn)。

# reCAPTCHA v2 invisible (site_key 未設定時は captcha 無しで動く。
# secret_key は production では未設定 = fail-closed)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- admin (Filament /admin) ---
# 初期管理者は env では投入しない (本番は `php artisan admin:create`、local は AdminUserSeeder)
# 管理画面の MFA (TOTP) 必須化 (本番は true 必須。local / CI のみ false でスキップ可)
ADMIN_MFA_REQUIRED=true

# --- devcontainer ---
# docker-compose の Postgres パスワード (tracked file に credential を置かないための env 経由。dev 既定: postgres)
POSTGRES_PASSWORD=postgres
