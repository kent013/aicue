# APP_ENV=testing のとき Laravel が .env の代わりに読むファイル (コミット対象)。
# ここには secret を置かない (すべてテスト専用のダミー値)。
#
# 優先順位: shell env (devcontainer の docker-compose export が最優先)
#   → phpunit.xml の <server force> → 本ファイル。
# phpunit 経由のテストでは DB_CONNECTION 等は phpunit.xml が force し、
# DB_DATABASE は tests/bootstrap.php が `<slug>_test_<worktree-hash>` を注入する。
# 本ファイルの値は接続先 (DB_HOST 等) の既定と、bootstrap を経由しない
# testing 経路 (php artisan tinker --env=testing 等) のフォールバック。

APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:KQC+PCNo20tslruffNaanVRgrDY65+UScyBQOLqRka4=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# devcontainer では docker-compose が DB_HOST=db 等を export するため shell env が勝つ
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
# DB_DATABASE は tests/bootstrap.php が worktree ごとに一意な test DB 名を注入する
# (例: app_test_<hash>)。paratest 実行時は更に `_test_<token>` が付与される。
# 下記値はフォールバック (bootstrap を経由しない testing 経路向け。dev DB 名を書かないこと)
DB_DATABASE=app_test_fallback

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
CACHE_PREFIX=

MAIL_MAILER=array
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

# --- billing (Stripe API はテストから呼ばない) ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=jpy
STRIPE_PRICE_STANDARD=price_standard_placeholder

# --- template ---
TEMPLATE_APP_SLUG=app
TEMPLATE_TEAMS_VISIBLE=false

# --- security / auth (テスト専用ダミーキー。本番キーを置かないこと) ---
CIPHERSWEET_KEY=a4deb94facb2cdcfb8954382a6a46aefd0b62f91d3daa4f6baf87302767250e3
LEGAL_CONSENT_VERSION=draft-1
