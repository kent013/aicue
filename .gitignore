*.log
.DS_Store
.env
.env.backup
.env.local
.env.bughunt.local
.env.production
.phpactor.json
.phpunit.result.cache
/.claude/bug-hunt.lock
# PostToolUse 索引更新 hook の作業ファイル置き場 (ロック / 告知フラグ)
/.claude/code-review-graph-update-hook/
# worktree 実体と setup/teardown lock (scripts/setup-worktree.sh / teardown-worktree.sh)
/.claude/worktrees/
/.code-review-graph/
/.codex
/.cursor/
/.fleet
/.idea
/.nova
/.phpunit.cache
# pest-plugin-browser が失敗時 screenshot を書く (runtime artifact)
/tests/Browser/Screenshots/
/.vscode/*
!/.vscode/settings.json
/.zed
/auth.json
/.pnpm-store
/node_modules
/packages/*/coverage
/packages/*/dist
/packages/*/dist-test
/packages/*/node_modules
# oclif prepack が生成する CLI コマンド manifest (packages/cli)
/packages/*/oclif.manifest.json
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
# prism prompt debug の出力先 (config/prism-prompt.php の storage_path)
/storage/prism-prompt-debug/
# bug-hunt コード到達カバレッジの出力先 (scripts/bug-hunt-shard.sh --coverage)
/storage/bughunt-coverage/
# Browser lane がレーン別に退避する失敗時 screenshot (CI の失敗時アップロード対象)
/storage/browser-test-artifacts/
/vendor
# Deployer の実 host 座標 (実 IP / SSH ユーザー / deploy_path)。
# 追跡下に置くのは deploy/hosts.example.yml (placeholder のみ) だけである
# (tests/Architecture/DeployCoordinateHygieneTest.php が追跡下の実座標を禁じる)。
/deploy/hosts.yml
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Python
__pycache__/
*.pyc

# 外部 skill (skills-lock.json から再インストール可能。.claude/skills/* は symlink)
/.agents
/.claude/skills/stripe-*
# `upgrade-stripe` だけ名前が `stripe-` で始まらず上の glob に入らないため、個別行で閉じる
# (skills-lock.json の全キーが閉じていることは SkillsLockIgnoreCoverageTest が強制する)
/.claude/skills/upgrade-stripe

# template repo specific
/tmp

# Filament が php artisan filament:assets / filament:upgrade で再生成する
# publish 済みアセット (コミットせず各環境で再生成する)
/public/css/filament/
/public/js/filament/
/public/fonts/filament/

# bug-hunt run の実行時状態 (ブラウザセッション / console ログ)。
# レポート (shard-report.md) と screenshots は残し、ランタイム状態は追跡しない。
devnotes/**/.playwright/
devnotes/**/.playwright-cli/
