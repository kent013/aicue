+    import FormField from "@/components/molecules/FormField.svelte";
+
+    /**
+     * SOP (手順書) の後付けアップロード (POST .../source-documents。Inertia multipart form)。
+     * 追記型 immutable: アップロードは常に新しい行を追加する (差し替え = 最新が解析対象)。
